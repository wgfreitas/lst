# LST — environment variables contract.
# Copy to `.env` and fill in the blanks. Never commit the real `.env`.

# Ollama Cloud API key (required).
# Create one at https://ollama.com and paste the token below.
OLLAMA_API_KEY=

# Model identifier used by the LLM Explainer stage.
# Must be available on your Ollama Cloud account.
# Examples: gpt-oss:20b, gpt-oss:120b, llama3.1:70b, qwen2.5:72b
OLLAMA_MODEL=gpt-oss:20b

# OpenAI-compatible base URL. Override only if self-hosting a proxy.
OLLAMA_BASE_URL=https://ollama.com/v1

# HTTP timeout (seconds) for a single request to the Ollama endpoint.
LLM_TIMEOUT_SECONDS=60

# Automatic retry budget for transient LLM failures (5xx, rate-limit).
LLM_MAX_RETRIES=2

# Maximum tokens the LLM may emit. Default 1024 handles multi-sentence
# pt-BR explanations comfortably. Reduce to ~400 for cost-sensitive
# runs against expensive models.
LLM_MAX_TOKENS=1024
