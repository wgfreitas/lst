# LST — environment variables contract.
# Copy to `.env` and fill in the blanks. Never commit the real `.env`.

# LLM provider API key (required).
# Bearer token for whichever OpenAI-compatible provider LST targets.
# (The v1.0.0 name OLLAMA_API_KEY still works as an alias — see note below.)
LLM_API_KEY=

# Model identifier used by the LLM Explainer stage. Must exist on the
# configured provider/plan. Examples per provider:
#   Ollama Cloud : gpt-oss:20b, gpt-oss:120b
#   GLM (Z.ai)   : glm-5.2
#   OpenAI       : gpt-4o-mini
LLM_MODEL=gpt-oss:20b

# OpenAI-compatible chat-completions base URL. LST works with any
# provider exposing this protocol; only LLM_BASE_URL, LLM_MODEL, and
# LLM_API_KEY change between providers:
#   Ollama Cloud (default) : https://ollama.com/v1
#   GLM Coding (Z.ai)      : https://api.z.ai/api/coding/paas/v4   (model glm-5.2)
#   OpenRouter             : https://openrouter.ai/api/v1
#   OpenAI                 : https://api.openai.com/v1
LLM_BASE_URL=https://ollama.com/v1

# Backward compatibility: the v1.0.0 variable names OLLAMA_API_KEY,
# OLLAMA_MODEL, and OLLAMA_BASE_URL are still accepted as aliases for the
# three LLM_* variables above, so an existing v1.0.0 .env keeps working.
# Prefer the LLM_* names for new setups.

# HTTP timeout (seconds) for a single request to the LLM endpoint.
LLM_TIMEOUT_SECONDS=60

# Automatic retry budget for transient LLM failures (5xx, rate-limit).
LLM_MAX_RETRIES=2

# Maximum tokens the LLM may emit. Default 1024 handles multi-sentence
# pt-BR explanations comfortably. Reduce to ~400 for cost-sensitive
# runs against expensive models.
LLM_MAX_TOKENS=1024
